# ===== EACOswap Backend Configuration =====
# Copy this file to .env and fill in your API keys

# Server Port
PORT=3000

# Helius API Key (Solana RPC & Enhanced APIs)
# Get your free key at: https://dashboard.helius.dev
# Free tier: 1M credits/month, supports RPC + DAS API + NFT API + Webhooks
HELIUS_API_KEY=YOUR_HELIUS_API_KEY_HERE

# Optional: Birdeye API Key (Solana Token Data)
# Get your free key at: https://birdeye.so
# Free tier: limited requests/day
BIRDEYE_API_KEY=YOUR_BIRDEYE_API_KEY_HERE

# Optional: Jupiter API Key (Swap Quotes)
# Not strictly required for basic quote API
# JUPITER_API_KEY=

# Optional: Dune Analytics API Key
# DUNE_API_KEY=

# Rate Limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=60

# CORS Origins (comma-separated, or * for all in development)
CORS_ORIGINS=*

# Cache TTL (seconds)
CACHE_TTL=60
