<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/select_wallet"
        android:textAppearance="?attr/textAppearanceHeadline6"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/wallet_phantom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Phantom"
        app:icon="@drawable/ic_wallet"
        style="@style/Widget.Material3.Button.OutlinedButton" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/wallet_solflare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Solflare"
        android:layout_marginTop="8dp"
        app:icon="@drawable/ic_wallet"
        style="@style/Widget.Material3.Button.OutlinedButton" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/wallet_backpack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Backpack"
        android:layout_marginTop="8dp"
        app:icon="@drawable/ic_wallet"
        style="@style/Widget.Material3.Button.OutlinedButton" />

</LinearLayout>
