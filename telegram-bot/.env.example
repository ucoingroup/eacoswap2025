# ==========================================
# EACO Swap Telegram Bot Environment Config
# ==========================================

# Telegram Bot Token (from @BotFather)
# NEVER commit the real token to git
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# WebApp URL (must be HTTPS for Telegram Mini Apps)
WEBAPP_URL=https://your-domain.com

# Backend API URL (eacoswap-pro backend)
BACKEND_URL=http://localhost:3000/api

# Server port (for webhook mode)
PORT=8443

# Webhook URL (full HTTPS URL for Telegram to send updates)
WEBHOOK_URL=https://your-domain.com:8443/webhook

# Running mode: polling | webhook
MODE=polling

# Optional: Set bot menu button text
MENU_BUTTON_TEXT=Open App

# Optional: Debug mode (true/false)
DEBUG=false
