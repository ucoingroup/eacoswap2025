# EACO Swap Telegram MiniApp Environment Variables
# Copy to .env and fill in your values

# Backend API URL (required)
VITE_BACKEND_URL=https://api.eacoswap.example.com

# Telegram Bot Username for MiniApp links
VITE_BOT_USERNAME=eacoswap_bot

# Jupiter API Endpoint (optional, defaults to public)
VITE_JUPITER_API=https://quote-api.jup.ag/v6

# Optional: Helius API Key for enhanced RPC (client-side, stored in localStorage by user)
# VITE_HELIUS_API_KEY=

# Optional: Birdeye API Key
# VITE_BIRDEYE_API_KEY=

# Build mode
VITE_NODE_ENV=production
